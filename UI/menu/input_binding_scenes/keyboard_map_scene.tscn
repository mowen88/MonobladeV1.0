[sub_resource type="GDScript" id="GDScript_yg5kw"]
script/source = "extends CanvasLayer

signal back_requested

@export var reset_sound: AudioStream

@onready var control: Control = $Control
@onready var column_1: VBoxContainer = $Control/KeyboardMenu/HBoxContainer/Column1
@onready var column_2: VBoxContainer = $Control/KeyboardMenu/HBoxContainer/Column2
@onready var back_button: Button = $Control/KeyboardMenu/BackButton
@onready var reset_defaults_button: Button = $Control/KeyboardMenu/ResetDefaultsButton
@onready var tooltip_label: Label = $Control/ColorRect/TooltipLabel

# Track remapping state
var remapping_button: Button = null
var remapping_action: String = \"\"

# Override key names to fit the UI width
const KEY_LABEL_OVERRIDES := {
	\"Left Mouse Button\": \"LMB\",
	\"Right Mouse Button\": \"RMB\",
	\"Mouse Wheel Up\": \"MW Up\",
	\"Mouse Wheel Down\": \"MW Down\",
	\"Wheel Up\": \"MW Up\",
	\"Wheel Down\": \"MW Down\",
	\"Middle Mouse Button\": \"MMB\",
	\"Mouse Button 4\": \"MB4\",
	\"Mouse Button 5\": \"MB5\",
	\"Escape\": \"Esc\",
	\"Delete\": \"Del\",
	\"Caps Lock\": \"Caps\",
	\"Num Lock\": \"NumLock\",
	\"Scroll Lock\": \"ScrollLock\",
	\"Print Screen\": \"PrtSc\",
	\"Kp Enter\": \"NumEnter\",
	\"Kp Multiply\": \"Num*\",
	\"Kp Add\": \"Num+\",
	\"Kp Subtract\": \"Num-\",
	\"Kp Divide\": \"Num/\",
}

func _format_input_event_label(ev: InputEvent) -> String:
	if ev is InputEventMouseButton:
		match ev.button_index:
			MOUSE_BUTTON_LEFT:
				return \"LMB\"
			MOUSE_BUTTON_RIGHT:
				return \"RMB\"
			MOUSE_BUTTON_MIDDLE:
				return \"MMB\"
			MOUSE_BUTTON_XBUTTON1:
				return \"M4\"
			MOUSE_BUTTON_XBUTTON2:
				return \"M5\"

	var raw := ev.as_text()
	raw = raw.replace(\" (Physical)\", \"\")
	raw = raw.replace(\"Physical\", \"\")
	raw = raw.replace(\" Mouse Button\", \"\")
	raw = raw.replace(\"-\", \"\")
	raw = raw.replace(\":\", \"\")
	raw = raw.strip_edges()

	if KEY_LABEL_OVERRIDES.has(raw):
		return KEY_LABEL_OVERRIDES[raw]

	return raw

func _ready() -> void:
	
	control.visible = false
	tooltip_label.visible = false
	
	_setup_focus_neighbors()
	_update_all_button_labels()

	back_button.pressed.connect(func(): back_requested.emit())
	reset_defaults_button.pressed.connect(_on_reset_defaults_requested)

func _on_reset_defaults_requested() -> void:
	remapping_button = null
	remapping_action = \"\"
	tooltip_label.visible = false
	SaveManager.reset_input_mappings_to_default()
	AudioManager.play_sfx(reset_sound)
	_update_all_button_labels()

func _setup_focus_neighbors() -> void:
	var col1_buttons = _get_buttons_in_column(column_1)
	var col2_buttons = _get_buttons_in_column(column_2)

	var max_rows = max(col1_buttons.size(), col2_buttons.size())

	var col1_last = col1_buttons.back() if col1_buttons.size() > 0 else reset_defaults_button
	var col2_last = col2_buttons.back() if col2_buttons.size() > 0 else back_button
	var col1_first = col1_buttons[0] if col1_buttons.size() > 0 else reset_defaults_button

	# 1. Strict Vertical & Horizontal wiring for Column 1
	for i in range(col1_buttons.size()):
		var btn = col1_buttons[i]

		if i > 0:
			btn.focus_neighbor_top = col1_buttons[i - 1].get_path()
		else:
			btn.focus_neighbor_top = back_button.get_path()

		if i < col1_buttons.size() - 1:
			btn.focus_neighbor_bottom = col1_buttons[i + 1].get_path()
		else:
			btn.focus_neighbor_bottom = reset_defaults_button.get_path()

		# TRAP LEFT: Prevent pressing left from escaping Column 1
		btn.focus_neighbor_left = btn.get_path()

	# 2. Strict Vertical & Horizontal wiring for Column 2
	for i in range(col2_buttons.size()):
		var btn = col2_buttons[i]

		if i > 0:
			btn.focus_neighbor_top = col2_buttons[i - 1].get_path()
		else:
			btn.focus_neighbor_top = back_button.get_path()

		if i < col2_buttons.size() - 1:
			btn.focus_neighbor_bottom = col2_buttons[i + 1].get_path()
		else:
			btn.focus_neighbor_bottom = reset_defaults_button.get_path()

	# 3. Strict Horizontal bridging between columns at the same index
	for i in range(max_rows):
		var btn1 = col1_buttons[i] if i < col1_buttons.size() else null
		var btn2 = col2_buttons[i] if i < col2_buttons.size() else null

		if btn1 and btn2:
			btn1.focus_neighbor_right = btn2.get_path()
			btn2.focus_neighbor_left = btn1.get_path()
		elif btn2:
			btn2.focus_neighbor_left = btn2.get_path()

	# 4. Wiring for ResetDefaultsButton (above BackButton)
	reset_defaults_button.focus_neighbor_top = col1_last.get_path()
	reset_defaults_button.focus_neighbor_bottom = back_button.get_path()
	reset_defaults_button.focus_neighbor_left = col1_last.get_path()
	reset_defaults_button.focus_neighbor_right = col2_last.get_path()

	# 5. Wiring for BackButton (bottom of menu)
	back_button.focus_neighbor_top = reset_defaults_button.get_path()
	back_button.focus_neighbor_bottom = col1_first.get_path()

	
func _get_buttons_in_column(col: VBoxContainer) -> Array:
	var buttons = []
	for row in col.get_children():		
		if row is HBoxContainer:
			for child in row.get_children():
				if child is Button:
					buttons.append(child)
					if not child.pressed.is_connected(_on_button_pressed):
						child.pressed.connect(_on_button_pressed.bind(child))
	return buttons

func _update_all_button_labels() -> void:
	var col1_buttons = _get_buttons_in_column(column_1)
	var col2_buttons = _get_buttons_in_column(column_2)
	for btn in col1_buttons + col2_buttons:
		_update_button_text_for_action(btn)

func _update_button_text_for_action(btn: Button) -> void:
	var action_name = btn.name.replace(\"Button\", \"\")
	if InputMap.has_action(action_name):
		var events = InputMap.action_get_events(action_name)
		if events.size() > 0:
			btn.text = _format_input_event_label(events[0])
		else:
			btn.text = \"Unassigned\"
			
func _on_button_pressed(btn: Button) -> void:
	
	if remapping_button != null:
		return
		
	var action_name = btn.name.replace(\"Button\", \"\")
	
	if InputMap.has_action(action_name):
		remapping_button = btn
		remapping_action = action_name
		btn.text = \"???\"
		tooltip_label.visible = true
		

func _input(event: InputEvent) -> void:
	if remapping_button == null:
		return

	# Block gamepad buttons and stick/trigger motions in keyboard menu
	if event is InputEventJoypadButton or event is InputEventJoypadMotion:
		if event.is_pressed() or (event is InputEventJoypadMotion and abs(event.axis_value) >= 0.5):
			get_viewport().set_input_as_handled()
			return
	
	if event is InputEventMouseButton and event.double_click:
		get_viewport().set_input_as_handled()
		return

	if (event is InputEventMouseButton or event is InputEventKey) and event.is_pressed():
		get_viewport().set_input_as_handled()

		InputMap.action_erase_events(remapping_action)
		InputMap.action_add_event(remapping_action, event)
		if event is InputEventKey:
			print(\"Action:\", remapping_action, \" | pressed keycode:\", event.keycode, \" physical:\", event.physical_keycode, \" | events now:\", InputMap.action_get_events(remapping_action))
		elif event is InputEventMouseButton:
			print(\"Action:\", remapping_action, \" | mouse button:\", event.button_index, \" | events now:\", InputMap.action_get_events(remapping_action))

		_update_button_text_for_action(remapping_button)
		remapping_button = null
		remapping_action = \"\"
		tooltip_label.visible = false
		SaveManager.save_input_mappings()
"

